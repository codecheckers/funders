@misc{jensen_high_2015,
	title = {High {Througput} {pKa} {Prediction} {Using} {Semi} {Empirical} {Methods}},
	url = {http://arxiv.org/abs/1512.00701},
	doi = {10.48550/arXiv.1512.00701},
	abstract = {A large proportion of organic molecules relevant to medicine and biotechnology contain one or more ionizable groups, which means that fundamental physical and chemical properties (e.g. the charge of the molecule) depend on the pH of the surroundings via the corresponding pKa values of the molecules. As drug- and material design increasingly is being done through high throughput screens, fast - yet accurate - computational pKa prediction methods are becoming crucial to the design process. Current empirical pKa predictors are increasingly found to fail because they are being applied to parts of chemical space for which experimental parameterization data is lacking. We propose to develop a pKa predictor that, due its quantum mechanical foundation, is more generally applicable but still fast enough to be used in high throughput screening. The method has the potential to impact virtually any biotechnological design process involving organic molecules as we will demonstrate for metabolic engineering and organic battery design.},
	urldate = {2025-02-04},
	publisher = {arXiv},
	author = {Jensen, Jan H.},
	month = dec,
	year = {2015},
	note = {arXiv:1512.00701 [physics]},
	keywords = {Physics - Chemical Physics},
	annote = {Comment: Submitted to the Danish National Science Foundation 2015.10.27},
	file = {Preprint PDF:C\:\\Users\\P018013\\Zotero\\storage\\SXPB9ZIM\\Jensen - 2015 - High Througput pKa Prediction Using Semi Empirical.pdf:application/pdf;Snapshot:C\:\\Users\\P018013\\Zotero\\storage\\82YL3ZJE\\1512.html:text/html},
}

@article{fournier_migratory_2014,
	title = {Migratory {Stopover} {Timing}, {Survival} and {Habitat} {Use} of {Fall} {Migrating} {Sora} in {Managed} {Wetlands} in {Missouri}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://figshare.com/articles/journal_contribution/Migratory_Stopover_Timing_Survival_and_Habitat_Use_of_Fall_Migrating_Sora_in_Managed_Wetlands_in_Missouri/5215966/1},
	doi = {10.6084/M9.FIGSHARE.5215966.V1},
	abstract = {Evidence suggests rails are in decline and their decline may be related to loss of wetlands across the continent (Conway 2008, Eddleman et al. 1988, Tiner 1984). The Migratory Shore and Upland Game Bird Support Task Force for rails and snipe identified four priority information needs. One of which targeted the estimation of survival rates of rails, using the Sora (Porzana carolina) as a surrogate for other rail species (Case and McCool 2009). Marking rails during fall migration was suggested as a means to estimate annual survival rates. Fall was targeted because rails are easier to capture when water availability is limited on the landscape due to climate and management decisions. Wetland habitat is limited in the fall because water is drawn out of many wetlands in late summer as part of moist soil management for migratory waterfowl habitat (Fredrickson and Taylor 1982). Waterfowl habitat and management is a priority on many public lands (Soulliere et al. 2007). Considerable research has been done on the benefits moist-soil management has for both waterfowl and shorebirds (Fredrickson and Taylor 1992, Reinecke et al. 1989, Lyons et al. 2008). Less is known about how wetland management influences rail habitat during fall migration. By better understanding the ecology of wetland use by rails during the fall and the habitats rails use, managers can better manage for a wider suite of wetland dependent species. I propose continuing our existing nocturnal surveys and putting radio transmitters out on Sora to better understand their stopover duration, habitat use and survival during fall migration. https://www.ogrants.org/grants/fournier\_auriel\_2014},
	urldate = {2025-02-04},
	author = {Fournier, Auriel},
	year = {2014},
	note = {Artwork Size: 744653 Bytes
Publisher: figshare},
	keywords = {FOS: Biological sciences, Ecology},
	pages = {744653 Bytes},
	file = {Fournier - 2017 - Migratory Stopover Timing, Survival and Habitat Us.pdf:C\:\\Users\\P018013\\Zotero\\storage\\KKXGN9ZJ\\Fournier - 2017 - Migratory Stopover Timing, Survival and Habitat Us.pdf:application/pdf},
}

